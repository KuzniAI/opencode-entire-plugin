{
  "compilerOptions": {
    "target": "es2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDirs": ["./src"],
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}